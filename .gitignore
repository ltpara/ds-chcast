build/
Testing/
*.user
.vs/
*.yuv
*.h264
*.h265
*.bmp

# Optional third-party virtual display driver package: fetched locally by
# tools/fetch-usbmmidd.ps1, never committed.
drivers/usbmmidd_v2/

# Runtime secrets and machine-local state: a server identity seed is generated
# on first run, and the viewer writes its settings next to the executable.
chast-server-identity.key
chast-server-state.db
chast-server-state.json
ds-chcastbuildpf-gui.ini

# Local process markers and temporary review snapshots.
/host.pid
/server/server.pid
/.hostdiff.txt
/.hs_review.diff

# Certificates, private keys, logs and audit spools produced by local runs.
# These are runtime material; a development tree must never publish them.
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.log
*.jsonl
